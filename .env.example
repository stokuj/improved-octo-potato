# Docker Compose & Development configuration defaults
# Copy to .env and change values if needed

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# ── Backend ───────────────────────────────────────────────────────────────────
AUTH_SECRET=temporary-development-secret-must-be-32-chars
ADMIN_SESSION_SECRET=temporary-admin-session-secret-32-chars

# ── Frontend ──────────────────────────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:8000/api

# ── Production only ───────────────────────────────────────────────────────────
# APP_DOMAIN=example.com
# APP_WWW_DOMAIN=www.example.com
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
