# Database Configuration
# For Docker Compose:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/app
SQL_ECHO=false

# Security - REQUIRED: Generate a random string of at least 32 characters
# You can use: openssl rand -hex 32
AUTH_SECRET=tu-wpisz-bardzo-dlugi-sekret-minimum-32-znaki
ADMIN_SESSION_SECRET=tu-wpisz-bardzo-dlugi-sekret-admina-minimum-32-znaki

# CORS allowed origins (JSON array string or comma-separated)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
